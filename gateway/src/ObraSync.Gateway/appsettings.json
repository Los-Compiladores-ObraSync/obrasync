{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Resiliencia": {
    "MaxReintentos": 3,
    "EsperaBaseMs": 200,
    "RatioFallas": 0.5,
    "MinimoPedidos": 5,
    "VentanaSegundos": 30,
    "PausaSegundos": 15
  },
  "ReverseProxy": {
    "Routes": {
      "usuarios": {
        "ClusterId": "usuarios",
        "Match": { "Path": "/api/usuarios/{**resto}" }
      },
      "obras": {
        "ClusterId": "usuarios",
        "Match": { "Path": "/api/obras/{**resto}" }
      },
      "requisiciones": {
        "ClusterId": "requisiciones",
        "Match": { "Path": "/api/requisiciones/{**resto}" }
      },
      "catalogo": {
        "ClusterId": "requisiciones",
        "Match": { "Path": "/api/catalogo/{**resto}" }
      },
      "licitaciones": {
        "ClusterId": "licitaciones",
        "Match": { "Path": "/api/licitaciones/{**resto}" }
      },
      "cotizaciones": {
        "ClusterId": "licitaciones",
        "Match": { "Path": "/api/cotizaciones/{**resto}" }
      },
      "recepciones": {
        "ClusterId": "recepcion",
        "Match": { "Path": "/api/recepciones/{**resto}" }
      },
      "presupuestos": {
        "ClusterId": "recepcion",
        "Match": { "Path": "/api/presupuestos/{**resto}" }
      }
    },
    "Clusters": {
      "usuarios": {
        "Destinations": { "principal": { "Address": "http://localhost:5001/" } }
      },
      "requisiciones": {
        "Destinations": { "principal": { "Address": "http://localhost:5002/" } }
      },
      "licitaciones": {
        "Destinations": { "principal": { "Address": "http://localhost:5003/" } }
      },
      "recepcion": {
        "Destinations": { "principal": { "Address": "http://localhost:5004/" } }
      }
    }
  }
}
