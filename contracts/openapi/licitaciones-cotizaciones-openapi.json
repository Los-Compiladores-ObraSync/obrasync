{
  "openapi": "3.0.4",
  "info": {
    "title": "ObraSync.Licitaciones.Api",
    "version": "1.0",
    "description": "API del microservicio de Licitaciones y Cotizaciones de ObraSync Enterprise. Primer corte (Sprint 1): pliegos y cotizaciones básicos. Magic Links y scoring quedan para el Sprint 2."
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/licitaciones": {
      "get": {
        "tags": ["Licitaciones"],
        "summary": "Listar pliegos con filtros opcionales (Roles: Comprador, Proveedor, Admin)",
        "parameters": [
          {
            "name": "obraId",
            "in": "query",
            "description": "Filtrar pliegos por el identificador de la obra.",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "estado",
            "in": "query",
            "description": "Filtrar pliegos por estado.",
            "required": false,
            "schema": { "type": "string", "nullable": true }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Número de página (1 en adelante).",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Cantidad de elementos por página (entre 1 y 50).",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Total-Count": {
                "description": "Total de elementos que coinciden con el filtro",
                "schema": { "type": "integer" }
              },
              "X-Page": {
                "description": "Página actual",
                "schema": { "type": "integer" }
              },
              "X-Page-Size": {
                "description": "Tamaño de página aplicado",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LicitacionResponseDto" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Licitaciones"],
        "summary": "Publicar un pliego a partir de una requisición aprobada, con el plazo para cotizar (Roles: Comprador, Admin). 404 si la requisición no existe o no está aprobada (acá solo se guardan requisiciones aprobadas, es el mismo caso; el 400 por 'no aprobada' no se usa). 400 si la fecha límite no es futura (UTC). 409 si ya hay una licitación Abierta para esa requisición.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CrearLicitacionRequestDto" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LicitacionResponseDto" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/licitaciones/{id}": {
      "get": {
        "tags": ["Licitaciones"],
        "summary": "Obtener un pliego por Id (Roles: Comprador, Proveedor, Admin)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único (GUID) del pliego.",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LicitacionResponseDto" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/cotizaciones": {
      "get": {
        "tags": ["Cotizaciones"],
        "summary": "Listar las cotizaciones de un pliego (Roles: Comprador, Admin)",
        "parameters": [
          {
            "name": "licitacionId",
            "in": "query",
            "description": "Identificador del pliego del que se listan las cotizaciones.",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Número de página (1 en adelante).",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Cantidad de elementos por página (entre 1 y 50).",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 50 }
          },
          { "name": "pesoPrecio", "in": "query", "required": false, "description": "Peso del precio en el puntaje (>= 0). Por defecto 0,5.", "schema": { "type": "number", "format": "double", "minimum": 0, "default": 0.5 } },
          { "name": "pesoFlete", "in": "query", "required": false, "description": "Peso del flete (>= 0). Por defecto 0,2.", "schema": { "type": "number", "format": "double", "minimum": 0, "default": 0.2 } },
          { "name": "pesoPlazo", "in": "query", "required": false, "description": "Peso del plazo (>= 0). Por defecto 0,2.", "schema": { "type": "number", "format": "double", "minimum": 0, "default": 0.2 } },
          { "name": "pesoCalificacion", "in": "query", "required": false, "description": "Peso de la calificación del proveedor (>= 0). Por defecto 0,1. No hace falta que sumen 1: se dividen por su suma. 400 si alguno es negativo o si todos son 0.", "schema": { "type": "number", "format": "double", "minimum": 0, "default": 0.1 } }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Total-Count": {
                "description": "Total de elementos que coinciden con el filtro",
                "schema": { "type": "integer" }
              },
              "X-Page": {
                "description": "Página actual",
                "schema": { "type": "integer" }
              },
              "X-Page-Size": {
                "description": "Tamaño de página aplicado",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CotizacionResponseDto" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Cotizaciones"],
        "summary": "Cargar una cotización para un pliego (Roles: Proveedor, Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CrearCotizacionRequestDto" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CotizacionResponseDto" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/cotizaciones/mias": {
      "get": {
        "tags": ["Cotizaciones"],
        "summary": "Listar las cotizaciones propias del proveedor autenticado y su resultado de adjudicación (Roles: Proveedor, Admin)",
        "description": "Permite a un Proveedor consultar únicamente sus propias cotizaciones (tomando su identificador del claim 'sub' del token JWT) y conocer si su oferta fue adjudicada, sin exponer cotizaciones ni precios de otros proveedores. Un Admin puede indicar opcionalmente proveedorId por query string.",
        "parameters": [
          {
            "name": "proveedorId",
            "in": "query",
            "description": "Identificador del proveedor a consultar (solo aplicable para el rol Admin; para Proveedor se utiliza siempre el claim 'sub' del JWT).",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Número de página (1 en adelante).",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Cantidad de elementos por página (entre 1 y 50).",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Total-Count": {
                "description": "Total de elementos que coinciden con el filtro",
                "schema": { "type": "integer" }
              },
              "X-Page": {
                "description": "Página actual",
                "schema": { "type": "integer" }
              },
              "X-Page-Size": {
                "description": "Tamaño de página aplicado",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MiCotizacionResponseDto" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/proveedores/{proveedorId}/calificacion": {
      "put": {
        "tags": ["Proveedores"],
        "summary": "Cargar o actualizar la calificación (1 a 5) de un proveedor. Una fila por proveedor: re-calificar actualiza (Roles: Comprador, Admin)",
        "parameters": [
          { "name": "proveedorId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CalificacionProveedorRequestDto" } } }
        },
        "responses": {
          "200": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CalificacionProveedorResponseDto" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "get": {
        "tags": ["Proveedores"],
        "summary": "Consultar la calificación de un proveedor (Roles: Comprador, Admin). 404 si no tiene calificación cargada.",
        "parameters": [
          { "name": "proveedorId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CalificacionProveedorResponseDto" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/licitaciones/{licitacionId}/adjudicar": {
      "post": {
        "tags": ["Licitaciones"],
        "summary": "Adjudicar una cotización y emitir la Orden de Compra",
        "description": "Permite a un Comprador o Administrador adjudicar una cotización ganadora para una licitación.",
        "parameters": [
          {
            "name": "licitacionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["cotizacionId"],
                "properties": {
                  "cotizacionId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Orden de Compra emitida exitosamente."
          },
          "400": {
            "description": "Datos inválidos o la cotización no pertenece a la licitación."
          },
          "404": {
            "description": "No se encontró la licitación o la cotización."
          },
          "409": {
            "description": "La licitación ya se encuentra adjudicada o hay conflicto con el estado."
          }
        }
      }
    },
    "/api/licitaciones/{licitacionId}/magic-links": {
      "post": {
        "tags": ["MagicLinks"],
        "summary": "Generar un enlace temporal de un solo uso (Magic Link) para que un proveedor cotice (Roles: Comprador, Admin)",
        "parameters": [
          {
            "name": "licitacionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["proveedorId"],
                "properties": {
                  "proveedorId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enlace generado exitosamente."
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/licitaciones/magic-links/{hash}/cotizar": {
      "post": {
        "tags": ["MagicLinks"],
        "summary": "Cotizar un pliego utilizando un Magic Link de un solo uso (Público / AllowAnonymous)",
        "security": [],
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "description": "Token temporal de un solo uso recibido por el proveedor.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items", "flete", "plazoEntregaDias"],
                "properties": {
                  "flete": { "type": "number", "format": "double", "minimum": 0 },
                  "plazoEntregaDias": { "type": "integer", "format": "int32", "minimum": 1 },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["precioUnitario"],
                      "properties": {
                        "licitacionItemId": { "type": "string", "format": "uuid" },
                        "articuloId": { "type": "string", "format": "uuid" },
                        "precioUnitario": { "type": "number", "format": "double", "exclusiveMinimum": true, "minimum": 0 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cotización validada y registrada exitosamente.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CotizacionResponseDto" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido por ObraSync.Usuarios.Api (HS256) con claims: sub, email, name, role."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request (Datos de entrada inválidos)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Forbidden": {
        "description": "Forbidden (Rol no autorizado)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "NotFound": {
        "description": "Not Found (Recurso inexistente)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Conflict": {
        "description": "Conflict (Ya existe una licitación abierta para la requisición)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      }
    },
    "schemas": {
      "PliegoItemDto": {
        "type": "object",
        "required": ["articuloId", "descripcion", "cantidad", "unidadMedida"],
        "properties": {
          "articuloId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del artículo en el catálogo."
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción o nombre del artículo."
          },
          "cantidad": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": true,
            "minimum": 0,
            "description": "Cantidad requerida del artículo (mayor a cero)."
          },
          "unidadMedida": {
            "type": "string",
            "description": "Unidad de medida (ej: BOLSA, KG, M3, UNIDAD)."
          }
        },
        "additionalProperties": false
      },
      "CrearLicitacionRequestDto": {
        "type": "object",
        "required": ["requisicionId", "fechaLimiteCotizacion"],
        "properties": {
          "requisicionId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador de la requisición aprobada que origina el pliego."
          },
          "fechaLimiteCotizacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora límite (UTC) hasta la cual los proveedores pueden cargar cotizaciones. Debe ser posterior al momento de publicación."
          }
        },
        "additionalProperties": false
      },
      "LicitacionResponseDto": {
        "type": "object",
        "required": ["licitacionId", "requisicionId", "obraId", "estado", "fechaCreacion", "fechaLimiteCotizacion", "items"],
        "properties": {
          "fechaLimiteCotizacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora límite (UTC) para cargar cotizaciones, definida por el Comprador al publicar el pliego."
          },
          "licitacionId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del pliego."
          },
          "requisicionId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador de la requisición de origen."
          },
          "numeroRequisicion": {
            "type": "string",
            "description": "Identificador humano legible de la requisición (ej: REQ-2026-0001)."
          },
          "obraId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador de la obra destino."
          },
          "estado": {
            "type": "string",
            "description": "Estado actual del pliego: Abierta, Cerrada o Adjudicada."
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora de creación del pliego (en UTC)."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PliegoItemDto" },
            "description": "Materiales a cotizar."
          },
          "yaCotizada": {
            "type": "boolean",
            "nullable": true,
            "description": "Solo se completa cuando quien consulta es un Proveedor: true si ya cotizó este pliego, false si todavía no. Para Comprador y Admin viene en null (no aplica). Campo opcional, compatible hacia atrás."
          }
        },
        "additionalProperties": false
      },
      "CrearCotizacionItemDto": {
        "type": "object",
        "required": ["articuloId", "precioUnitario"],
        "properties": {
          "articuloId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del artículo en el catálogo."
          },
          "precioUnitario": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Precio unitario ofertado (una sola divisa en el MVP)."
          }
        },
        "additionalProperties": false
      },
      "CrearCotizacionRequestDto": {
        "type": "object",
        "required": ["licitacionId", "proveedorId", "items"],
        "properties": {
          "licitacionId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del pliego que se cotiza."
          },
          "proveedorId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del proveedor que cotiza."
          },
          "flete": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Costo de flete ofertado."
          },
          "plazoEntregaDias": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "description": "Plazo de entrega ofertado, en días."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/CrearCotizacionItemDto" },
            "description": "Precios ofertados por artículo."
          }
        },
        "additionalProperties": false
      },
      "CotizacionResponseDto": {
        "type": "object",
        "required": ["cotizacionId", "licitacionId", "proveedorId", "subtotalItems", "flete", "costoTotal", "esMasBarata", "fechaCreacion", "items", "puntajeTotal", "esGanadora"],
        "properties": {
          "cotizacionId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador de la cotización."
          },
          "licitacionId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del pliego cotizado."
          },
          "proveedorId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador del proveedor que cotizó."
          },
          "subtotalItems": {
            "type": "number",
            "format": "double",
            "description": "Subtotal de los ítems cotizados (suma de cantidad del pliego por precioUnitario de cada artículo, CU-07)."
          },
          "flete": {
            "type": "number",
            "format": "double",
            "description": "Costo de flete ofertado (CU-07)."
          },
          "costoTotal": {
            "type": "number",
            "format": "double",
            "description": "Costo total de la oferta (subtotalItems + flete) para la comparativa de cotizaciones (CU-07)."
          },
          "esMasBarata": {
