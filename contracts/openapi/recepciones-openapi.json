          },
          "montoTotal": {
            "type": "number"
          },
          "partidaPresupuestariaId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "montoComprometidoPartida": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "OrdenCompraLiquidadaDto": {
        "type": "object",
        "description": "Respuesta tras liquidar administrativamente una orden de compra sin saldo pendiente (#92).",
        "properties": {
          "ordenCompraId": {
            "type": "string",
            "format": "uuid"
          },
