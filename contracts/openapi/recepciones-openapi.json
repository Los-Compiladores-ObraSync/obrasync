            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      },
      "CrearRecepcionRequest": {
        "type": "object",
        "description": "Datos para registrar una recepción completa. El identificador del usuario receptor se obtiene del JWT y no se envía en el cuerpo.",
        "required": [
          "obraId",
          "ordenCompraId",
          "numeroRemito",
          "fechaRecepcion",
          "detalles"
        ],
        "properties": {
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "ordenCompraId": {
            "type": "string",
            "format": "uuid"
          },
          "numeroRemito": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "fechaRecepcion": {
            "type": "string",
            "format": "date-time",
            "description": "La fecha no puede superar el dia siguiente a la fecha UTC del servidor. Se permite un dia de tolerancia por la diferencia horaria con Argentina."
          },
          "observaciones": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "detalles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/CrearDetalleRecepcionRequest"
            }
          }
        },
        "additionalProperties": false
      },
      "CrearDetalleRecepcionRequest": {
        "type": "object",
        "description": "Datos de un material incluido en la recepción.",
        "required": [
          "articuloId",
          "descripcionArticulo",
          "cantidadEsperada",
          "cantidadRecibida",
          "unidadMedida",
          "conforme"
        ],
        "properties": {
          "articuloId": {
            "type": "string",
            "format": "uuid"
          },
          "descripcionArticulo": {
            "type": "string",
            "maxLength": 250
          },
          "cantidadEsperada": {
            "type": "number",
            "minimum": 0
          },
          "cantidadRecibida": {
            "type": "number",
            "minimum": 0
          },
          "unidadMedida": {
            "type": "string",
            "maxLength": 20
          },
          "conforme": {
            "type": "boolean"
          },
          "observacion": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Recepcion": {
        "type": "object",
        "description": "Información de una recepción de materiales y su remito.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "ordenCompraId": {
            "type": "string",
            "format": "uuid"
          },
          "recepcionadoPorUsuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "numeroRemito": {
            "type": "string",
            "maxLength": 50
          },
          "fechaRecepcion": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1 = Pendiente, 2 = Parcial, 3 = Completa, 4 = Rechazada."
          },
          "observaciones": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleRecepcion"
            }
          }
        }
      },
      "DetalleRecepcion": {
        "type": "object",
