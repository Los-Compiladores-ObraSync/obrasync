{
  "openapi": "3.0.4",
  "info": {
    "title": "ObraSync - Recepción y Presupuesto",
    "version": "1.0.0",
    "description": "Contrato OpenAPI para consultar recepciones y registrar entregas completas con remito digital."
  },
  "tags": [
    {
      "name": "Recepciones",
      "description": "Consulta y registro de recepciones de materiales."
    }
  ],
  "paths": {
    "/api/recepciones": {
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Consultar recepciones",
        "description": "Obtiene las recepciones registradas y sus materiales. Permite filtrar opcionalmente por obra y por orden de compra.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "obraId",
            "in": "query",
            "description": "Identificador de la obra por la cual se desea filtrar.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ordenCompraId",
            "in": "query",
            "description": "Identificador de la orden de compra por la cual se desea filtrar.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de recepciones obtenida correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecepcionDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "No autorizado para consultar recepciones."
          }
        }
      },
      "post": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Registrar una recepción total de materiales",
        "description": "Registra una recepción completa contra una orden de compra existente. Todas las cantidades recibidas deben coincidir con las compradas. Las entregas parciales se rechazan en este sprint. El usuario receptor se obtiene del claim sub del JWT. Solo pueden registrar recepciones los roles Capataz y Admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearRecepcionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recepción completa registrada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecepcionDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos, orden de compra inexistente, artículo ajeno a la OC, cantidades incorrectas o entrega parcial.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El usuario no tiene el rol Capataz o Admin."
          },
          "409": {
            "description": "La orden de compra ya fue recibida por completo o el número de remito está repetido para esa OC.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/recepciones/{id}": {
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Consultar recepción por identificador",
        "description": "Obtiene una recepción por su identificador único junto con el detalle de materiales recibidos.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador único de la recepción.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recepción obtenida correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecepcionDto"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "404": {
            "description": "La recepción no existe.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/recepciones/ordenes-pendientes": {
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Consultar órdenes de compra pendientes",
        "description": "Obtiene las órdenes de compra que aún no tienen una recepción completa, con cálculo acumulado de cantidades recibidas. Permite filtrar opcionalmente por obra. Requiere rol Capataz o Admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "obraId",
            "in": "query",
            "description": "Identificador de la obra para filtrar las órdenes pendientes.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de órdenes de compra pendientes de recibir.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrdenPendienteDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El usuario no tiene el rol Capataz o Admin."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      },
      "CrearRecepcionRequest": {
        "type": "object",
        "description": "Datos para registrar una recepción completa. El identificador del usuario receptor se obtiene del JWT y no se envía en el cuerpo.",
        "required": [
          "obraId",
          "ordenCompraId",
          "numeroRemito",
          "fechaRecepcion",
          "detalles"
        ],
        "properties": {
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "ordenCompraId": {
            "type": "string",
            "format": "uuid"
          },
          "numeroRemito": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "fechaRecepcion": {
            "type": "string",
            "format": "date-time"
          },
          "observaciones": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "detalles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/CrearDetalleRecepcionRequest"
            }
          }
        },
        "additionalProperties": false
      },
      "CrearDetalleRecepcionRequest": {
        "type": "object",
        "description": "Datos de un material incluido en la recepción.",
        "required": [
          "articuloId",
          "descripcionArticulo",
          "cantidadEsperada",
          "cantidadRecibida",
          "unidadMedida",
          "conforme"
        ],
        "properties": {
          "articuloId": {
            "type": "string",
            "format": "uuid"
          },
          "descripcionArticulo": {
            "type": "string",
            "maxLength": 250
          },
          "cantidadEsperada": {
            "type": "number",
            "minimum": 0
          },
          "cantidadRecibida": {
            "type": "number",
            "minimum": 0
          },
          "unidadMedida": {
            "type": "string",
            "maxLength": 20
          },
          "conforme": {
            "type": "boolean"
          },
          "observacion": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Recepcion": {
        "type": "object",
        "description": "Información de una recepción de materiales y su remito.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "ordenCompraId": {
            "type": "string",
            "format": "uuid"
          },
          "recepcionadoPorUsuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "numeroRemito": {
            "type": "string",
            "maxLength": 50
          },
          "fechaRecepcion": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1 = Pendiente, 2 = Parcial, 3 = Completa, 4 = Rechazada."
          },
          "observaciones": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleRecepcion"
            }
          }
        }
      },
      "DetalleRecepcion": {
        "type": "object",
        "description": "Información de cada material incluido en una recepción.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recepcionId": {
            "type": "string",
            "format": "uuid"
          },
          "articuloId": {
            "type": "string",
            "format": "uuid"
          },
          "descripcionArticulo": {
            "type": "string",
            "maxLength": 250
          },
          "cantidadEsperada": {
            "type": "number"
          },
          "cantidadRecibida": {
            "type": "number"
          },
          "unidadMedida": {
            "type": "string",
            "maxLength": 20
          },
          "conforme": {
            "type": "boolean"
          },
          "observacion": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "RecepcionDto": {
        "type": "object",
        "description": "DTO de respuesta con la información de una recepción de materiales y su remito.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "ordenCompraId": {
            "type": "string",
            "format": "uuid"
          },
          "recepcionadoPorUsuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "numeroRemito": {
            "type": "string",
            "maxLength": 50
          },
          "fechaRecepcion": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1 = Pendiente, 2 = Parcial, 3 = Completa, 4 = Rechazada."
          },
          "observaciones": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleRecepcionDto"
            }
          }
        }
      },
      "DetalleRecepcionDto": {
        "type": "object",
        "description": "DTO de respuesta con la información de cada material incluido en una recepción.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recepcionId": {
            "type": "string",
            "format": "uuid"
          },
          "articuloId": {
            "type": "string",
            "format": "uuid"
          },
          "descripcionArticulo": {
            "type": "string",
            "maxLength": 250
          },
          "cantidadEsperada": {
            "type": "number"
          },
          "cantidadRecibida": {
            "type": "number"
          },
          "unidadMedida": {
            "type": "string",
            "maxLength": 20
          },
          "conforme": {
            "type": "boolean"
          },
          "observacion": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "OrdenPendienteDto": {
        "type": "object",
        "description": "Orden de compra pendiente de recibir.",
        "properties": {
          "ordenCompraId": {
            "type": "string",
            "format": "uuid"
          },
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOrdenPendienteDto"
            }
          }
        }
      },
      "ItemOrdenPendienteDto": {
        "type": "object",
        "description": "Ítem de una orden de compra pendiente con cantidades esperadas y recibidas acumuladas.",
        "properties": {
          "articuloId": {
            "type": "string",
            "format": "uuid"
          },
          "descripcionArticulo": {
            "type": "string"
          },
          "cantidadEsperada": {
            "type": "number"
          },
          "cantidadRecibida": {
            "type": "number"
          },
          "unidadMedida": {
            "type": "string"
          }
        }
      }
    }
  }
}
