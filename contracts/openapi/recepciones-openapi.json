{
  "openapi": "3.0.4",
  "info": {
    "title": "ObraSync - Recepción y Presupuesto",
    "version": "1.0.0",
    "description": "Contrato OpenAPI para consultar recepciones y registrar entregas completas con remito digital."
  },
  "tags": [
    {
      "name": "Recepciones",
      "description": "Consulta y registro de recepciones de materiales."
    },
    {
      "name": "Presupuestos",
      "description": "Carga y consulta de partidas presupuestarias por obra y etapa (#93, #154)."
    }
  ],
  "paths": {
    "/api/recepciones": {
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Consultar recepciones",
        "description": "Obtiene las recepciones registradas y sus materiales. Permite filtrar opcionalmente por obra y por orden de compra. Roles permitidos: Capataz, Comprador y Admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "obraId",
            "in": "query",
            "description": "Identificador de la obra por la cual se desea filtrar.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ordenCompraId",
            "in": "query",
            "description": "Identificador de la orden de compra por la cual se desea filtrar.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Número de página (1 en adelante).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Cantidad de elementos por página (entre 1 y 50).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de recepciones obtenida correctamente.",
            "headers": {
              "X-Total-Count": {
                "description": "Total de elementos que coinciden con el filtro",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page": {
                "description": "Página actual",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page-Size": {
                "description": "Tamaño de página aplicado",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecepcionDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Paginación inválida (pagina < 1 o tamano fuera del rango 1..50).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "No autorizado para consultar recepciones, o la obra filtrada no está asignada al Capataz."
          },
          "503": {
            "description": "No se pudo verificar la obra asignada porque Usuarios y Obras no respondió."
          }
        }
      },
      "post": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Registrar una recepción total o parcial de materiales",
        "description": "Registra una recepción total o parcial contra una orden de compra despachada y activa, calculando el estado Parcial (2) o Completa (3) según si las cantidades recibidas acumuladas cubren la totalidad de la OC (#90). Rechaza con 400 si la cantidad recibida acumulada por ítem supera lo pedido en la OC o si la recepción tiene todas las cantidades recibidas en 0. El usuario receptor se obtiene del claim sub del JWT. Solo pueden registrar recepciones los roles Capataz y Admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearRecepcionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recepción (total o parcial) registrada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecepcionDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos, orden de compra inexistente, artículo ajeno a la OC, cantidades negativas o en cero total, cantidad esperada inválida o cantidad recibida acumulada que supera lo pedido en la OC.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El usuario no tiene el rol Capataz o Admin, o la obra no está asignada al Capataz."
          },
          "503": {
            "description": "No se pudo verificar la obra asignada porque Usuarios y Obras no respondió."
          },
          "409": {
            "description": "La orden de compra está bloqueada por desvío presupuestario, todavía no fue despachada, ya fue recibida por completo o el número de remito está repetido para esa OC.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/recepciones/{id}": {
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Consultar recepción por identificador",
        "description": "Obtiene una recepción por su identificador único junto con el detalle de materiales recibidos. Roles permitidos: Capataz, Comprador y Admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador único de la recepción.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recepción obtenida correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecepcionDto"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "Rol no autorizado, o la recepción pertenece a una obra no asignada al Capataz."
          },
          "404": {
            "description": "La recepción no existe.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "No se pudo verificar la obra asignada porque Usuarios y Obras no respondió."
          }
        }
      }
    },
    "/api/recepciones/ordenes-pendientes": {
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Consultar órdenes de compra pendientes",
        "description": "Obtiene las órdenes de compra activas y ya despachadas (OrdenCompraDespachadaEvent procesado) que aún no tienen una recepción completa, con cálculo acumulado de cantidades recibidas. Permite filtrar opcionalmente por obra y sinPartida. Roles permitidos: Capataz, Comprador y Admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "obraId",
            "in": "query",
            "description": "Identificador de la obra para filtrar las órdenes pendientes.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sinPartida",
            "in": "query",
            "description": "Filtra órdenes pendientes según si carecen de partida presupuestaria asignada (true) o si tienen partida asignada (false).",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Número de página (1 en adelante).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Cantidad de elementos por página (entre 1 y 50).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de órdenes de compra pendientes de recibir.",
            "headers": {
              "X-Total-Count": {
                "description": "Total de elementos que coinciden con el filtro",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page": {
                "description": "Página actual",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page-Size": {
                "description": "Tamaño de página aplicado",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrdenPendienteDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Paginación inválida (pagina < 1 o tamano fuera del rango 1..50).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El usuario no tiene el rol Capataz, Comprador o Admin, o la obra filtrada no está asignada al Capataz."
          },
          "503": {
            "description": "No se pudo verificar la obra asignada porque Usuarios y Obras no respondió."
          }
        }
      }
    },
    "/api/recepciones/ordenes-bloqueadas": {
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Consultar órdenes de compra bloqueadas por desvío presupuestario (#210)",
        "description": "Obtiene las órdenes de compra actualmente en estado Bloqueada por superar la partida presupuestaria asignada (#95, #210). Cada elemento expone los datos del desvío presupuestario equivalentes a OrdenCompraBloqueadaEvent evaluados contra el estado actual de la partida emparejada, junto con partidaId y fechaBloqueo (UTC). Permite filtrar opcionalmente por obraId y soporta paginación con pagina, tamano y encabezados X-Total-Count, X-Page y X-Page-Size (#172, #185). Roles permitidos: Comprador y Admin (Capataz y Proveedor reciben 403 Forbidden).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "obraId",
            "in": "query",
            "description": "Identificador opcional de la obra para filtrar las órdenes bloqueadas.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Número de página (1 en adelante).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Cantidad de elementos por página (entre 1 y 50).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada de órdenes de compra actualmente bloqueadas.",
            "headers": {
              "X-Total-Count": {
                "description": "Total de elementos que coinciden con el filtro",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page": {
                "description": "Página actual",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page-Size": {
                "description": "Tamaño de página aplicado",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrdenBloqueadaDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Paginación inválida (pagina < 1 o tamano fuera del rango 1..50).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El usuario no tiene el rol Comprador o Admin (Capataz y Proveedor no están autorizados)."
          }
        }
      }
    },
    "/api/recepciones/ordenes/{id}/liberar": {
      "post": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Autorizar y liberar una orden de compra bloqueada por desvío presupuestario (#96)",
        "description": "Exclusivo para el rol Admin. Libera una orden de compra en estado Bloqueada pasándola a Activa, registra quién (claim sub del JWT) y cuándo (UTC) autorizó la liberación, y suma su monto sin tope a montoComprometido de la partida presupuestaria correspondiente (#154, #210). Como consecuencia intencional, montoDisponible puede quedar negativo para reflejar el desvío autorizado y mantener el bloqueo preventivo sobre futuras órdenes de esa partida.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador único de la orden de compra a liberar.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiberarOrdenCompraRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Orden de compra liberada exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdenCompraLiberadaDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de solicitud inválidos (por ejemplo, motivo mayor a 500 caracteres).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido o el claim sub no es un GUID válido."
          },
          "403": {
            "description": "El usuario no tiene el rol Admin (Comprador, Capataz y Proveedor no están autorizados)."
          },
          "404": {
            "description": "La orden de compra no existe.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto: la orden de compra no se encuentra en estado Bloqueada.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/recepciones/ordenes/{id}/liquidar": {
      "post": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Liquidar administrativamente una orden de compra (#92)",
        "description": "Liquida administrativamente una orden de compra solo si no existe saldo pendiente de recepción (criterio CU-06). Bloquea con 409 Conflict (ProblemDetails) mientras exista saldo pendiente, si la orden está bloqueada por desvío presupuestario o si ya fue liquidada. Roles permitidos: Comprador y Admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador único de la orden de compra a liquidar.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orden de compra liquidada exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdenCompraLiquidadaDto"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido o el claim sub no es un GUID válido."
          },
          "403": {
            "description": "El usuario no tiene el rol Comprador o Admin."
          },
          "404": {
            "description": "La orden de compra no existe.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto: la orden de compra tiene saldo pendiente de recepción (excedente no entregado), está bloqueada por desvío presupuestario o ya fue liquidada.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/presupuestos/partidas": {
      "get": {
        "tags": [
          "Presupuestos"
        ],
        "summary": "Consultar partidas presupuestarias",
        "description": "Obtiene las partidas presupuestarias registradas con sus montos (asignado, comprometido, ejecutado y disponible). Permite filtrar por obra y por etapa. Roles: Admin, Comprador, Capataz.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "obraId",
            "in": "query",
            "description": "Filtro opcional por identificador de obra.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "etapa",
            "in": "query",
            "description": "Filtro opcional por nombre de la etapa.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Número de página (1 en adelante).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "description": "Cantidad de elementos por página (entre 1 y 50).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de partidas presupuestarias.",
            "headers": {
              "X-Total-Count": {
                "description": "Total de elementos que coinciden con el filtro",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page": {
                "description": "Página actual",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Page-Size": {
                "description": "Tamaño de página aplicado",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PartidaPresupuestariaDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Paginación inválida (pagina < 1 o tamano fuera del rango 1..50).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El rol del usuario no tiene permisos de lectura."
          }
        }
      },
      "post": {
        "tags": [
          "Presupuestos"
        ],
        "summary": "Dar de alta una partida presupuestaria",
        "description": "Registra una nueva partida presupuestaria para una obra y etapa. Roles: Admin, Comprador.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearPartidaPresupuestariaRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Partida presupuestaria creada exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartidaPresupuestariaDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de solicitud inválidos o incompletos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El rol del usuario no tiene permisos de escritura."
          },
          "409": {
            "description": "Conflicto: ya existe una partida con ese código o para esa etapa en la obra.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/presupuestos/partidas/{id}": {
      "get": {
        "tags": [
          "Presupuestos"
        ],
        "summary": "Consultar partida presupuestaria por ID",
        "description": "Obtiene el detalle de una partida presupuestaria específica. Roles: Admin, Comprador, Capataz.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único de la partida presupuestaria.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la partida presupuestaria.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartidaPresupuestariaDto"
                }
              }
            }
          },
          "401": {
            "description": "No se proporcionó un token válido."
          },
          "403": {
            "description": "El usuario no tiene permisos para consultar la partida."
          },
          "404": {
            "description": "Partida no encontrada.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
