            "type": "string",
            "format": "uuid"
          },
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "etapa": {
            "type": "string",
            "nullable": true,
            "description": "Etapa de la obra a la que pertenece la orden de compra."
          },
          "sinPartidaPresupuestaria": {
            "type": "boolean",
            "description": "Indica si la orden de compra no encontró partida presupuestaria de etapa ni general de obra."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOrdenPendienteDto"
            }
          }
        }
      },
      "ItemOrdenPendienteDto": {
        "type": "object",
        "description": "Ítem de una orden de compra pendiente con cantidades esperadas y recibidas acumuladas.",
        "properties": {
          "articuloId": {
            "type": "string",
            "format": "uuid"
          },
          "descripcionArticulo": {
            "type": "string"
          },
          "cantidadEsperada": {
            "type": "number"
          },
          "cantidadRecibida": {
            "type": "number"
          },
          "cantidadPendiente": {
            "type": "number",
            "description": "Saldo pendiente de recibir para este artículo (cantidadEsperada - cantidadRecibida)."
          },
          "unidadMedida": {
            "type": "string"
          }
        }
      },
      "CrearPartidaPresupuestariaRequest": {
        "type": "object",
        "required": [
          "obraId",
          "codigoPartida",
          "descripcion",
          "montoAsignado"
        ],
        "properties": {
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "etapa": {
            "type": "string",
            "nullable": true
          },
          "codigoPartida": {
            "type": "string",
            "maxLength": 50
          },
          "descripcion": {
            "type": "string",
            "maxLength": 250
          },
          "montoAsignado": {
            "type": "number",
            "minimum": 0
          },
          "moneda": {
            "type": "string",
            "default": "ARS",
            "maxLength": 10
          }
        }
      },
      "PartidaPresupuestariaDto": {
        "type": "object",
        "description": "Partida presupuestaria con sus montos contables (#93, #154, #210). Fórmula confirmada: montoDisponible = montoAsignado - montoComprometido. montoEjecutado representa el gasto físico devengado por recepciones (planificado para actualizarse mediante EjecutarMonto en CrearRecepcionCommandHandler en las tarjetas #90/#91) y no se descuenta de montoDisponible para evitar doble descuento. Al liberar una orden bloqueada (#96), su monto se suma sin tope a montoComprometido, por lo que montoDisponible puede quedar negativo intencionalmente.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "obraId": {
            "type": "string",
            "format": "uuid"
          },
          "etapa": {
            "type": "string",
            "nullable": true
          },
          "codigoPartida": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "montoAsignado": {
            "type": "number"
          },
          "montoComprometido": {
            "type": "number",
            "description": "Total reservado por órdenes de compra activas o liberadas contra la partida."
          },
          "montoEjecutado": {
            "type": "number",
            "description": "Gasto real devengado al confirmar recepciones físicas (va aparte de montoComprometido y no se descuenta de montoDisponible; se actualizará en CrearRecepcionCommandHandler en #90/#91)."
          },
          "montoDisponible": {
            "type": "number",
            "description": "Calculado como montoAsignado - montoComprometido. Puede ser negativo si un Admin liberó una orden bloqueada (#96, #210)."
          },
          "moneda": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrdenBloqueadaDto": {
        "type": "object",
        "description": "Orden de compra bloqueada por desvío presupuestario (#210). Replica los datos de negocio de OrdenCompraBloqueadaEvent y suma partidaId y fechaBloqueo.",
        "properties": {
          "ordenCompraId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador de la orden de compra bloqueada."
          },
          "obraId": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador de la obra destino."
          },
          "partidaId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Identificador de la partida presupuestaria emparejada (null si no existe partida actualmente)."
          },
          "etapa": {
            "type": "string",
            "nullable": true,
            "description": "Etapa de la obra a la que pertenece la orden de compra."
          },
          "montoOrdenCompra": {
            "type": "number",
            "description": "Monto total de la orden de compra bloqueada."
          },
          "montoAsignadoPartida": {
            "type": "number",
            "description": "Monto total asignado en la partida presupuestaria emparejada."
          },
          "montoComprometidoActual": {
            "type": "number",
            "description": "Monto comprometido actual acumulado en la partida presupuestaria."
          },
          "montoProyectado": {
            "type": "number",
            "description": "Suma de montoComprometidoActual más montoOrdenCompra."
          },
          "exceso": {
            "type": "number",
            "description": "Diferencia en que montoProyectado supera a montoAsignadoPartida (0 si no hay exceso)."
          },
          "motivo": {
            "type": "string",
            "description": "Motivo del bloqueo por desvío presupuestario."
          },
          "fechaBloqueo": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora en UTC en que la orden de compra fue bloqueada."
          }
        }
      },
      "LiberarOrdenCompraRequest": {
        "type": "object",
        "description": "Cuerpo opcional para registrar una observación o motivo al liberar una orden de compra bloqueada (#96).",
        "properties": {
          "motivo": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrdenCompraLiberadaDto": {
        "type": "object",
        "description": "Respuesta tras liberar una orden de compra bloqueada con los datos de auditoría de autorización (#96).",
        "properties": {
