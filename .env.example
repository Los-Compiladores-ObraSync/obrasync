# Copiar este archivo como .env (el archivo .env NO se sube al repositorio) y completar los valores.
# Todos los integrantes deben usar el MISMO JWT_SECRET: si no, los servicios rechazan los tokens de Usuarios.

# Contraseña del usuario sa de SQL Server. Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
SQL_SA_PASSWORD=CambiarEstaClave123!

# Secreto con el que Usuarios firma los JWT (HS256) y los demás servicios los validan. Mínimo 32 caracteres.
JWT_SECRET=cambiar-este-secreto-por-uno-de-mas-de-32-caracteres

# RabbitMQ (opcional: si no se definen, se usa guest / guest)
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest
