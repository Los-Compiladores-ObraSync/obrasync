# Copiar este archivo como .env (el archivo .env NO se sube al repositorio) y completar los valores.
# Todos los integrantes deben usar el MISMO JWT_SECRET: si no, los servicios rechazan los tokens de Usuarios.

# Los secretos van VACÍOS a propósito: docker compose no arranca hasta que los completes con valores propios
# (un valor de ejemplo copiado tal cual sería público). Elegí cada uno vos.

# Contraseña del usuario sa de SQL Server. Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
SQL_SA_PASSWORD=

# Secreto con el que Usuarios firma los JWT (HS256) y los demás servicios los validan. Mínimo 32 caracteres.
# Generalo con: openssl rand -base64 48   (o cualquier texto largo y propio). No uses un valor de ejemplo.
JWT_SECRET=

# RabbitMQ (#169: usuario y contraseña obligatorios en Docker, sin valores por defecto inseguros)
RABBITMQ_USER=obrasync_user
RABBITMQ_PASS=

# Key de IA / Gateway LLM (#165): rotada periódicamente, NUNCA commitear el valor real ni compartir en chats
# Asistente de IA (#137): sin estas dos variables el servicio arranca igual, pero el chat responde 503 "no disponible".
# AI_BASE_URL es la dirección del gateway de IA de la cátedra (está en la tarjeta #137 de Trello, no se escribe en el repo).
# Gateway nuevo del profe (#211): una URL que termina en /v1 (compatible con OpenAI), un solo modelo desplegado y la clave
# como Bearer. El servicio detecta el estilo por el final de la URL; con las URLs de estilo Azure de antes sigue funcionando.
AI_API_KEY=
AI_BASE_URL=
# Modelo del chat. Con el gateway nuevo el nombre lleva el recurso: shared-unaj-newsku-resource/gpt-5-mini
# (si se deja vacío usa gpt-4.1-mini, que solo existe en el gateway anterior).
AI_DEPLOYMENT=
# Modelo para leer remitos por foto (#209). Con el gateway nuevo es el mismo gpt-5-mini (multimodal).
# Si se deja vacío, usa el mismo modelo del chat.
AI_DEPLOYMENT_REMITO=
# Herramientas de solo lectura generadas desde contracts/openapi (#151). Apagado por defecto: suma tokens a cada pedido al modelo.
# Poné true para probarlas (el asistente las ofrece según el rol, además de las escritas a mano).
HERRAMIENTAS_GENERADAS=false
# Pedidos por minuto y por IP a login, registro y recuperar contraseña (Gateway). 30 alcanza para ensayar con los scripts.
AUTH_RATE_LIMIT=30

# Claves VAPID para Web Push (#227 - Usuarios y Obras). NUNCA subir claves reales al repositorio.
# Generar un par nuevo con: npx web-push generate-vapid-keys
# Si se dejan vacías, usuarios-obras-api arranca igual (GET /vapid-public-key responde 503 y no envía push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@obrasync.local

# Presupuesto semilla (ARS) que se crea para cada etapa de una obra al crear la obra (y para las obras que ya
# existían, al reiniciar Usuarios). 0 = no se crean partidas solas. 5000000 es un valor de EJEMPLO: el monto lo define el equipo.
PRESUPUESTO_SEMILLA_POR_ETAPA=5000000

# Dirección del frontend que lleva el enlace del mail de "olvidé mi contraseña".
# Local: http://localhost:5173. Para abrir el enlace desde el celular, poné la dirección del túnel (ver README).
FRONTEND_BASE_URL=http://localhost:5173
