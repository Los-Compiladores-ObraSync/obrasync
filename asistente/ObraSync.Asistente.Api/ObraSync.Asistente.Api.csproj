<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Permite guardar la clave de IA en tu máquina con "dotnet user-secrets", fuera del repositorio. -->
    <UserSecretsId>obrasync-asistente-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObraSync.Asistente.Application\ObraSync.Asistente.Application.csproj" />
    <ProjectReference Include="..\ObraSync.Asistente.Infrastructure\ObraSync.Asistente.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.33" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
